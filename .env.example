# Copy this file to .env and adjust as needed.

# Postgres connection string
DATABASE_URL=postgres://giftpay:giftpay@localhost:5432/giftpay?sslmode=disable

# Secret used to sign session JWTs. MUST be changed for anything beyond local dev.
JWT_SECRET=change-me-to-a-long-random-string

# Port the HTTP server listens on
PORT=8080

# Access token lifetime, Go duration format (e.g. 15m, 1h, 24h)
TOKEN_TTL=1h

# Optional: any user who registers with this email (or already has this
# email) is automatically promoted to admin. Leave blank to disable.
ADMIN_EMAIL=admin@example.com

