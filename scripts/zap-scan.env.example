ZAP_TARGET_URL="https://ccpp-aws.forestener.com"
ZAP_IMAGE="ghcr.io/zaproxy/zaproxy:stable"

# Reports are written under timestamped folders below this base path.
ZAP_REPORT_BASE_DIR="/opt/ccpp-zap-reports"

# Optional extra flags passed to zap-baseline.py.
ZAP_PASSIVE_EXTRA_ARGS=""

# Optional extra flags passed to zap-full-scan.py.
ZAP_ACTIVE_EXTRA_ARGS=""

# Export findings to AWS Security Hub after each scan.
ZAP_EXPORT_SECURITY_HUB="true"
ZAP_SECURITY_HUB_REGION="ap-southeast-1"
ZAP_SECURITY_HUB_GENERATOR_ID="ccpp-zap"
# Leave blank to use the account default custom product ARN.
ZAP_SECURITY_HUB_PRODUCT_ARN=""

# Active scans against production are blocked unless you set this to true.
ZAP_ALLOW_ACTIVE_PRODUCTION_SCAN="false"

# Optional authenticated scan settings. When both username and password are
# set, the active scan script switches to a ZAP Automation Framework plan that
# authenticates first and then spiders/scans as that user.
ZAP_AUTH_USERNAME=""
ZAP_AUTH_PASSWORD=""
ZAP_AUTH_LOGIN_PAGE_URL="https://ccpp-aws.forestener.com/scanner-login.html"
ZAP_AUTH_LOGIN_REQUEST_URL="https://ccpp-aws.forestener.com/scanner-login"
ZAP_AUTH_LOGIN_REQUEST_BODY="email={%username%}&password={%password%}"
ZAP_AUTH_POLL_URL="https://ccpp-aws.forestener.com/scanner-auth-check"
ZAP_AUTH_LOGGED_IN_REGEX="Scanner authentication successful"
ZAP_AUTH_LOGGED_OUT_REGEX="missing bearer token"
ZAP_AUTH_START_URL="https://ccpp-aws.forestener.com/scanner-auth-check"
ZAP_AUTH_POLL_FREQUENCY="60"
